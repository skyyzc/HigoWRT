#!/bin/sh /etc/rc.common

START=95
STOP=15
USE_PROCD=1

PROG=/usr/sbin/higorosd

ensure_luci_on_8080() {
	local listeners
	listeners="$(uci -q show uhttpd | grep 'uhttpd.main.listen_http' || true)"

	if echo "$listeners" | grep -qE "[:\\]]80'?$" || \
	   ! echo "$listeners" | grep -qE "[:\\]]8080'?$"; then
		uci -q delete uhttpd.main.listen_http
		uci add_list uhttpd.main.listen_http='0.0.0.0:8080'
		uci add_list uhttpd.main.listen_http='[::]:8080'
		uci commit uhttpd
		/etc/init.d/uhttpd restart >/dev/null 2>&1 || true
	fi
}

start_service() {
	[ -x "$PROG" ] || return 1
	ensure_luci_on_8080

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env \
		HIGOROS_ADDR=0.0.0.0:80 \
		HIGOROS_FRONTEND_DIR=/www/higoros \
		HIGOROS_LUA_HANDLERS=/usr/share/higoros/lua/handlers \
		HIGOROS_CORS_ORIGIN=*
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
