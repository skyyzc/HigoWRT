CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y
CONFIG_CCACHE=y

CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=448

# Public first-boot probe lane. This deliberately excludes the unavailable
# MTK proprietary SDK and uses mt76's MT7996-family driver with MT7992 firmware.
CONFIG_PACKAGE_kmod-mt7992-firmware=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-higowrt=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# Never select proprietary packages without their audited SDK inputs.
# CONFIG_PACKAGE_kmod-mt_wifi7 is not set
# CONFIG_PACKAGE_kmod-mt_wifi_osal is not set
# CONFIG_PACKAGE_kmod-mt_hwifi is not set
# CONFIG_PACKAGE_kmod-mtk_pci is not set
# CONFIG_PACKAGE_kmod-mt7992 is not set
# CONFIG_PACKAGE_kmod-mt7992_dbg is not set
# CONFIG_PACKAGE_kmod-warp is not set
# CONFIG_PACKAGE_kmod-mediatek_hnat is not set
# CONFIG_PACKAGE_kmod-mtk_wed is not set
# CONFIG_PACKAGE_wifi-profile is not set
# CONFIG_PACKAGE_wifi-dats is not set
