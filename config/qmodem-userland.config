CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y

CONFIG_PACKAGE_qmodem=m
CONFIG_PACKAGE_qmodem_INCLUDE_SEAL=y
CONFIG_PACKAGE_qmodem-seal=m
CONFIG_PACKAGE_modem_scan=m
CONFIG_PACKAGE_tom_modem=m
CONFIG_PACKAGE_ubus-at-daemon=m
CONFIG_PACKAGE_sms-tool_q=m
CONFIG_PACKAGE_sms-forwarder-next=m
CONFIG_PACKAGE_luci-app-qmodem-next=m

# Phase 1 reuses the stock firmware's ABI-matched USB/QMI drivers and dialer.
# Do not select QModem vendor kernel modules in this package-only build.
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_vendor-qmi-wwan is not set
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_ADD_PCI_SUPPORT is not set
