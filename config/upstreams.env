# Auditable inputs. Update through a reviewed change, never implicitly in a release build.
HIGOWRT_REPOSITORY=https://github.com/Hiveton/higowrt.git
HIGOWRT_REF=25a3aefa7be5821fa7e5e4809ac34a09fa62ef24

# The uploaded production firmware identifies this source commit. This is the
# phase-1 compatibility baseline; Hiveton/higowrt above remains the phase-2 path.
IMMORTALWRT_REPOSITORY=https://github.com/padavanonly/immortalwrt-mt798x-24.10.git
IMMORTALWRT_REF=34bb738192e6033ce69edd5695c8c59abb6d38e5

# Feed build reconstruction. LuCI is proven by the installed luci-base version.
# The other feed commits are pinned at the last commit before the firmware's
# advertised release date because the image contains no feeds.buildinfo.
LUCI_REPOSITORY=https://github.com/immortalwrt/luci.git
LUCI_REF=69bb8509422c77359ae971ead0dd8aed69827471
PACKAGES_REPOSITORY=https://github.com/immortalwrt/packages.git
PACKAGES_REF=d69f5628bcf4dfbe336883665dd55002ab6b8197
ROUTING_REPOSITORY=https://github.com/openwrt/routing.git
ROUTING_REF=cd05be684e670095d20663d1c41766cf8b54de61
TELEPHONY_REPOSITORY=https://github.com/openwrt/telephony.git
TELEPHONY_REF=92892fa285360b8981f62bf4e0a097e6449e7e33

QMODEM_REPOSITORY=https://github.com/FUjr/QModem.git
QMODEM_REF=v3.2.0
